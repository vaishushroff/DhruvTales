{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile, role, preferences, preferred media format, and disabled status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "phoneNumber": { "type": "string", "maxLength": 32 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "bio": { "type": "string", "maxLength": 300 },
        "preferredLanguage": { "type": "string", "minLength": 2, "maxLength": 10 },
        "preferredFormat": { "type": "string", "enum": ["audio", "video"] },
        "role": { "type": "string", "enum": ["user", "creator", "admin"] },
        "isDisabled": { "type": "boolean" },
        "warningCount": { "type": "number", "description": "Server-only concurrent device login warning counter (auto-banned at 3)." },
        "banned": { "type": "boolean", "description": "Server-only account ban flag enforced across all /api routes." },
        "bannedAt": { "type": "string", "format": "date-time" },
        "banReason": { "type": "string", "maxLength": 300 },
        "activeDevice": { "type": "object", "description": "Server-only single active browser device record (deviceId, deviceInfo, registeredAt, lastSeen)." },
        "lastSeen": { "type": "string", "format": "date-time" },
        "avatarInitials": { "type": "string", "minLength": 1, "maxLength": 4 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "preferredLanguage", "role", "avatarInitials", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin role registry keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "grantedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Storytelling genre/category metadata with bilingual names.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9\\-]+$" },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 60 },
        "nameHi": { "type": "string", "minLength": 1, "maxLength": 60 },
        "descriptionEn": { "type": "string", "maxLength": 240 },
        "descriptionHi": { "type": "string", "maxLength": 240 },
        "accentHex": { "type": "string", "maxLength": 16 },
        "sortOrder": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "slug", "nameEn", "nameHi", "sortOrder", "isActive"]
    },
    "Creator": {
      "title": "Creator",
      "description": "Public storyteller / studio profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "handle": { "type": "string", "minLength": 1, "maxLength": 60 },
        "bioEn": { "type": "string", "maxLength": 400 },
        "bioHi": { "type": "string", "maxLength": 400 },
        "language": { "type": "string", "enum": ["en", "hi", "bilingual"] },
        "followersCount": { "type": "number" },
        "storiesCount": { "type": "number" },
        "verified": { "type": "boolean" },
        "accentPalette": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "ownerUid", "name", "handle", "language", "followersCount", "storiesCount", "verified"]
    },
    "Story": {
      "title": "Story",
      "description": "Serialized audio/video story catalog metadata with optional Admin-only story-level coin price override.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "titleHi": { "type": "string", "minLength": 1, "maxLength": 140 },
        "synopsis": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "synopsisHi": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "genreId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "language": { "type": "string", "enum": ["en", "hi", "bilingual"] },
        "creatorId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "creatorOwnerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "creatorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "coverUrl": { "type": "string", "maxLength": 300 },
        "backdropUrl": { "type": "string", "maxLength": 300 },
        "coverTheme": { "type": "string", "maxLength": 40 },
        "rating": { "type": "number" },
        "totalPlays": { "type": "number" },
        "episodeCount": { "type": "number" },
        "isTrending": { "type": "boolean" },
        "isEditorsPick": { "type": "boolean" },
        "isPopular": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "visibility": { "type": "string", "enum": ["published", "draft", "archived"] },
        "format": { "type": "string", "enum": ["audio", "video", "hybrid"] },
        "isInteractive": { "type": "boolean" },
        "priceOverrideCoins": { "type": ["number", "null"], "description": "Admin-only story-level coin price override applied to all episodes in this story." },
        "isDeleted": { "type": "boolean", "description": "Safe soft-delete flag (hidden from listeners, restorable by Admin)." },
        "deletedAt": { "type": ["string", "null"], "format": "date-time" },
        "deletedByUid": { "type": ["string", "null"], "maxLength": 128 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "slug", "title", "titleHi", "synopsis", "synopsisHi", "genreId",
        "language", "creatorId", "creatorOwnerUid", "creatorName", "coverTheme",
        "rating", "totalPlays", "episodeCount", "isTrending", "isEditorsPick",
        "isPopular", "isFeatured", "visibility", "format", "isInteractive",
        "publishedAt", "createdAt", "updatedAt"
      ]
    },
    "Episode": {
      "title": "Episode",
      "description": "Individual episode metadata referencing audio/video via provider-agnostic MediaRef and immutable-for-creator priceCoins (0 = free).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storyId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "creatorOwnerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "episodeNumber": { "type": "number" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "titleHi": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 600 },
        "descriptionHi": { "type": "string", "maxLength": 600 },
        "durationSec": { "type": "number" },
        "priceCoins": { "type": "number", "description": "Coin unlock price (0 = free). Set once by creator on creation; editable anytime by Admin." },
        "mediaRef": { "type": "object", "description": "Primary audio mediaRef { provider, id, type }" },
        "audioRef": { "type": "object", "description": "Explicit audio MediaRef { provider, id, type }" },
        "videoMediaRef": { "type": "object", "description": "Optional video MediaRef { provider, id, type } for Audio/Video switching" },
        "choicePoint": { "type": "object", "description": "Optional interactive branching choicePoint triggered at timestamp or episode end" },
        "isEnding": { "type": "boolean" },
        "isDeleted": { "type": "boolean", "description": "Safe soft-delete flag (hidden from listeners, restorable by Admin)." },
        "deletedAt": { "type": ["string", "null"], "format": "date-time" },
        "deletedByUid": { "type": ["string", "null"], "maxLength": 128 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "storyId", "creatorOwnerUid", "episodeNumber", "title", "titleHi",
        "durationSec", "priceCoins", "mediaRef", "publishedAt", "createdAt"
      ]
    },
    "CoinWallet": {
      "title": "CoinWallet",
      "description": "Server-authoritative coin wallet per user (read-only for clients; written only by Vercel /api/coins/* using Firebase Admin SDK).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "balance": { "type": "number" },
        "lifetimePurchased": { "type": "number" },
        "lifetimeSpent": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "balance", "lifetimePurchased", "lifetimeSpent", "updatedAt"]
    },
    "CoinTransaction": {
      "title": "CoinTransaction",
      "description": "Immutable coin ledger entry created exclusively by server-side Admin SDK routes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "enum": ["purchase", "spend", "admin_adjust", "bonus", "refund"] },
        "amount": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "episodeId": { "type": ["string", "null"] },
        "storyId": { "type": ["string", "null"] },
        "creatorId": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "note": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "uid", "type", "amount", "balanceAfter", "createdAt", "note"]
    },
    "EpisodeUnlock": {
      "title": "EpisodeUnlock",
      "description": "Permanent per-user paid episode unlock record written atomically by POST /api/coins/unlock.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "episodeId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "storyId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "pricePaidCoins": { "type": "number" },
        "transactionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "unlockedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "episodeId", "storyId", "pricePaidCoins", "transactionId", "unlockedAt"]
    },
    "CoinPackage": {
      "title": "CoinPackage",
      "description": "Admin-defined coin bundle available for simulated checkout via PaymentProvider.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "nameHi": { "type": "string", "maxLength": 80 },
        "coins": { "type": "number" },
        "bonusCoins": { "type": "number" },
        "priceInr": { "type": "number" },
        "active": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "coins", "bonusCoins", "priceInr", "active", "sortOrder"]
    },
    "EconomySettings": {
      "title": "EconomySettings",
      "description": "Admin-configurable platform economy settings (daily free episode toggle and daily limit).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["economy"] },
        "dailyFreeEnabled": { "type": "boolean" },
        "dailyFreeLimit": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedByUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "dailyFreeEnabled", "dailyFreeLimit", "updatedAt"]
    },
    "ListeningHistory": {
      "title": "ListeningHistory",
      "description": "Per-user episode playback progress, resume position, and denormalized storyOwnerUid for creator analytics.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storyId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storyOwnerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "episodeId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "episodeNumber": { "type": "number" },
        "positionSec": { "type": "number" },
        "durationSec": { "type": "number" },
        "completed": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "storyId", "episodeId", "episodeNumber", "positionSec", "durationSec", "completed", "updatedAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "User bookmarks, story favorites, and creator follows.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetType": { "type": "string", "enum": ["story_bookmark", "story_favorite", "creator_follow"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "targetType", "targetId", "createdAt"]
    },
    "DailyUnlock": {
      "title": "DailyUnlock",
      "description": "Record of daily free-episode unlocks claimed by a user (governed by platformSettings/economy).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storyId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "episodeId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "unlockDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "storyId", "episodeId", "unlockDate", "createdAt"]
    },
    "InteractiveChoice": {
      "title": "InteractiveChoice",
      "description": "Branching story choice node metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storyId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "episodeId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "promptEn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "promptHi": { "type": "string", "minLength": 1, "maxLength": 300 },
        "options": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "storyId", "episodeId", "promptEn", "promptHi", "options", "createdAt"]
    },
    "UserChoice": {
      "title": "UserChoice",
      "description": "Per-user chosen branch record for interactive stories, illuminating their constellation trail.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storyId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "episodeId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "choicePointId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "optionId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "optionLabelEn": { "type": "string", "minLength": 1, "maxLength": 160 },
        "optionLabelHi": { "type": "string", "minLength": 1, "maxLength": 160 },
        "nextEpisodeId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chosenAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "storyId", "episodeId", "choicePointId", "optionId", "optionLabelEn", "optionLabelHi", "nextEpisodeId", "chosenAt"]
    },
    "CreatorRequest": {
      "title": "CreatorRequest",
      "description": "User application to become a Dhruv Tales creator, reviewed and approved/rejected by an Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "studioName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "handle": { "type": "string", "minLength": 2, "maxLength": 60 },
        "language": { "type": "string", "enum": ["en", "hi", "bilingual"] },
        "pitch": { "type": "string", "minLength": 10, "maxLength": 600 },
        "sampleLink": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewNote": { "type": "string", "maxLength": 300 },
        "reviewedByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userEmail", "userName", "studioName", "handle", "language", "pitch", "status", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable, append-only audit log entry recorded for every Admin dashboard action.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "action": { "type": "string", "minLength": 1, "maxLength": 64 },
        "targetCollection": { "type": "string", "minLength": 1, "maxLength": 64 },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorUid", "actorEmail", "action", "targetCollection", "targetId", "summary", "createdAt"]
    },
    "SessionLog": {
      "title": "SessionLog",
      "description": "Immutable server-written single-device session and violation log entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "deviceId": { "type": "string", "maxLength": 128 },
        "deviceInfo": { "type": "object" },
        "eventType": {
          "type": "string",
          "enum": ["login_registered", "logout", "violation_warning", "violation_ban", "admin_ban", "admin_unban", "admin_reset_warnings", "admin_force_logout"]
        },
        "warningCountAfter": { "type": "number" },
        "bannedAfter": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "eventType", "warningCountAfter", "bannedAfter", "note", "createdAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Live Admin-editable site branding, colors, hero banners, homepage sections, enabled languages, footer, and legal pages.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["main"] },
        "branding": { "type": "object" },
        "footer": { "type": "object" },
        "heroBanners": { "type": "array" },
        "homepageSections": { "type": "array" },
        "languages": { "type": "array" },
        "defaultLanguage": { "type": "string", "minLength": 2, "maxLength": 10 },
        "legalPages": { "type": "object" },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "branding", "footer", "heroBanners", "homepageSections", "languages", "defaultLanguage", "legalPages", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles, preferred media format, disabled status, and RBAC role assignments (PII isolated to owner/admin)."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted admin UID allowlist."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Public genre/category catalog (Admin CRUD)."
    },
    "/creators/{creatorId}": {
      "schema": { "$ref": "#/entities/Creator" },
      "description": "Public storyteller profiles."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "Story catalog documents (Creators edit/delete own; Admins curate all and manage story-level priceOverrideCoins)."
    },
    "/episodes/{episodeId}": {
      "schema": { "$ref": "#/entities/Episode" },
      "description": "Episode metadata with provider-agnostic audio/video MediaRef, priceCoins (creator set-once, admin editable), and optional choicePoint."
    },
    "/wallets/{userId}": {
      "schema": { "$ref": "#/entities/CoinWallet" },
      "description": "Server-authoritative coin wallets (read-only for owner/admin; written exclusively by /api/coins/* using Firebase Admin SDK)."
    },
    "/coinTransactions/{txId}": {
      "schema": { "$ref": "#/entities/CoinTransaction" },
      "description": "Immutable coin ledger entries (read-only for owner/admin; written exclusively by /api/coins/*)."
    },
    "/episodeUnlocks/{unlockId}": {
      "schema": { "$ref": "#/entities/EpisodeUnlock" },
      "description": "Permanent paid episode unlock records (read-only for owner/admin; written exclusively by /api/coins/unlock)."
    },
    "/coinPackages/{packageId}": {
      "schema": { "$ref": "#/entities/CoinPackage" },
      "description": "Admin-defined coin packages for mock checkout (public read for active packages; Admin CRUD)."
    },
    "/platformSettings/{settingId}": {
      "schema": { "$ref": "#/entities/EconomySettings" },
      "description": "Admin-configurable economy settings (dailyFreeEnabled, dailyFreeLimit)."
    },
    "/listeningHistory/{historyId}": {
      "schema": { "$ref": "#/entities/ListeningHistory" },
      "description": "Per-user episode resume progress (readable by listener, owning story creator, or admin)."
    },
    "/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/Bookmark" },
      "description": "User bookmarks, favorites, and creator follows."
    },
    "/dailyUnlocks/{unlockId}": {
      "schema": { "$ref": "#/entities/DailyUnlock" },
      "description": "Daily free-episode unlock claims per user."
    },
    "/interactiveChoices/{choiceId}": {
      "schema": { "$ref": "#/entities/InteractiveChoice" },
      "description": "Interactive story branching nodes."
    },
    "/userChoices/{userChoiceId}": {
      "schema": { "$ref": "#/entities/UserChoice" },
      "description": "Per-user interactive story branch selections (strictly user-owned)."
    },
    "/creatorRequests/{requestId}": {
      "schema": { "$ref": "#/entities/CreatorRequest" },
      "description": "Become-a-Creator applications submitted by users and reviewed by admins."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable admin audit trail (admin-only read/create, no updates or deletes)."
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/SessionLog" },
      "description": "Immutable server-written single-device session and violation log (read-only for owner or admin)."
    },
    "/siteSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Live Admin-managed site branding, colors, banners, homepage sections, languages, footer, and legal page content."
    }
  }
}
