rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true) ||
        ('phone_number' in request.auth.token && request.auth.token.phone_number is string && request.auth.token.phone_number.size() >= 6)
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasUserDocAdminFlag(userData) {
      return ('admin' in userData && userData.admin == true) ||
        ('role' in userData && userData.role == 'admin');
    }

    function isAdmin() {
      return isVerified() && (
        (
          'email' in request.auth.token &&
          request.auth.token.email is string &&
          'email_verified' in request.auth.token &&
          request.auth.token.email_verified == true &&
          request.auth.token.email.lower() == 'vaishushroff@gmail.com'
        ) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          hasUserDocAdminFlag(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        )
      );
    }

    function isCreatorRole() {
      return isVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'creator' &&
        (!('isDisabled' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDisabled == false);
    }

    function isValidCoinPrice(val) {
      return val is number && val >= 0 && val <= 100000 && val % 1 == 0;
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'preferredLanguage',
          'role', 'avatarInitials', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'phoneNumber', 'displayName', 'bio', 'preferredLanguage', 'preferredFormat',
          'role', 'admin', 'isDisabled', 'warningCount', 'banned', 'bannedAt', 'banReason',
          'activeDevice', 'lastSeen', 'subscriptionTier', 'avatarInitials', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.email is string && data.email.size() <= 200 &&
        (data.email.size() >= 3 || ('phoneNumber' in data && data.phoneNumber is string && data.phoneNumber.size() >= 6 && data.phoneNumber.size() <= 32)) &&
        (!('phoneNumber' in data) || data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 32)) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 300)) &&
        data.preferredLanguage is string && data.preferredLanguage.size() >= 2 && data.preferredLanguage.size() <= 10 &&
        (!('preferredFormat' in data) || data.preferredFormat == null || data.preferredFormat in ['audio', 'video']) &&
        data.role in ['user', 'creator', 'admin'] &&
        (!('admin' in data) || data.admin is bool) &&
        (!('isDisabled' in data) || data.isDisabled is bool) &&
        (!('warningCount' in data) || (data.warningCount is number && data.warningCount >= 0 && data.warningCount <= 100 && data.warningCount % 1 == 0)) &&
        (!('banned' in data) || data.banned is bool) &&
        (!('bannedAt' in data) || data.bannedAt == null || data.bannedAt is timestamp) &&
        (!('banReason' in data) || data.banReason == null || (data.banReason is string && data.banReason.size() <= 300)) &&
        (!('activeDevice' in data) || data.activeDevice == null || data.activeDevice is map) &&
        (!('lastSeen' in data) || data.lastSeen == null || data.lastSeen is timestamp) &&
        (!('subscriptionTier' in data) || data.subscriptionTier == null || (data.subscriptionTier is string && data.subscriptionTier.size() <= 32)) &&
        data.avatarInitials is string && data.avatarInitials.size() >= 1 && data.avatarInitials.size() <= 4 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCategory(data, categoryId) {
      return data.keys().hasAll(['id', 'slug', 'nameEn', 'nameHi', 'sortOrder', 'isActive']) &&
        data.keys().hasOnly(['id', 'slug', 'nameEn', 'nameHi', 'descriptionEn', 'descriptionHi', 'accentHex', 'sortOrder', 'isActive']) &&
        data.id is string && data.id == categoryId && isValidId(data.id) &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 64 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 60 &&
        data.nameHi is string && data.nameHi.size() >= 1 && data.nameHi.size() <= 60 &&
        (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() <= 240)) &&
        (!('descriptionHi' in data) || (data.descriptionHi is string && data.descriptionHi.size() <= 240)) &&
        (!('accentHex' in data) || (data.accentHex is string && data.accentHex.size() <= 16)) &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        data.isActive is bool;
    }

    function isValidCreator(data, creatorId) {
      return data.keys().hasAll(['id', 'ownerUid', 'name', 'handle', 'language', 'followersCount', 'storiesCount', 'verified']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'name', 'handle', 'bioEn', 'bioHi', 'language', 'followersCount', 'storiesCount', 'verified', 'accentPalette']) &&
        data.id is string && data.id == creatorId && isValidId(data.id) &&
        data.ownerUid is string && isValidId(data.ownerUid) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.handle is string && data.handle.size() >= 1 && data.handle.size() <= 60 &&
        (!('bioEn' in data) || (data.bioEn is string && data.bioEn.size() <= 400)) &&
        (!('bioHi' in data) || (data.bioHi is string && data.bioHi.size() <= 400)) &&
        data.language in ['en', 'hi', 'bilingual'] &&
        data.followersCount is number && data.followersCount >= 0 &&
        data.storiesCount is number && data.storiesCount >= 0 &&
        data.verified is bool &&
        (!('accentPalette' in data) || (data.accentPalette is string && data.accentPalette.size() <= 40));
    }

    function isValidStory(data, storyId) {
      return data.keys().hasAll([
          'id', 'slug', 'title', 'titleHi', 'synopsis', 'synopsisHi', 'genreId',
          'language', 'creatorId', 'creatorOwnerUid', 'creatorName', 'coverTheme',
          'rating', 'totalPlays', 'episodeCount', 'isTrending', 'isEditorsPick',
          'isPopular', 'isFeatured', 'visibility', 'format', 'isInteractive',
          'publishedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'slug', 'title', 'titleHi', 'synopsis', 'synopsisHi', 'genreId',
          'language', 'creatorId', 'creatorOwnerUid', 'creatorName', 'coverUrl',
          'backdropUrl', 'coverTheme', 'rating', 'totalPlays', 'episodeCount',
          'isTrending', 'isEditorsPick', 'isPopular', 'isFeatured', 'visibility',
          'format', 'isInteractive', 'priceOverrideCoins', 'isDeleted', 'deletedAt', 'deletedByUid',
          'publishedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == storyId && isValidId(data.id) &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.titleHi is string && data.titleHi.size() >= 1 && data.titleHi.size() <= 140 &&
        data.synopsis is string && data.synopsis.size() >= 1 && data.synopsis.size() <= 1200 &&
        data.synopsisHi is string && data.synopsisHi.size() >= 1 && data.synopsisHi.size() <= 1200 &&
        data.genreId is string && isValidId(data.genreId) &&
        data.language in ['en', 'hi', 'bilingual'] &&
        data.creatorId is string && isValidId(data.creatorId) &&
        data.creatorOwnerUid is string && isValidId(data.creatorOwnerUid) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 100 &&
        (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 300)) &&
        (!('backdropUrl' in data) || (data.backdropUrl is string && data.backdropUrl.size() <= 300)) &&
        data.coverTheme is string && data.coverTheme.size() >= 1 && data.coverTheme.size() <= 40 &&
        data.rating is number && data.rating >= 0 && data.rating <= 5 &&
        data.totalPlays is number && data.totalPlays >= 0 &&
        data.episodeCount is number && data.episodeCount >= 0 && data.episodeCount <= 1000 &&
        data.isTrending is bool &&
        data.isEditorsPick is bool &&
        data.isPopular is bool &&
        data.isFeatured is bool &&
        data.visibility in ['published', 'draft', 'archived'] &&
        data.format in ['audio', 'video', 'hybrid'] &&
        data.isInteractive is bool &&
        (!('priceOverrideCoins' in data) || data.priceOverrideCoins == null || isValidCoinPrice(data.priceOverrideCoins)) &&
        (!('isDeleted' in data) || data.isDeleted is bool) &&
        (!('deletedAt' in data) || data.deletedAt == null || data.deletedAt is timestamp) &&
        (!('deletedByUid' in data) || data.deletedByUid == null || (data.deletedByUid is string && isValidId(data.deletedByUid))) &&
        data.publishedAt is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMediaRef(ref) {
      return ref is map &&
        ref.keys().hasAll(['provider', 'id', 'type']) &&
        ref.keys().hasOnly(['provider', 'id', 'type']) &&
        ref.provider in ['demo', 'drive', 'youtube', 'gcs'] &&
        ref.id is string && ref.id.size() >= 1 && ref.id.size() <= 1024 &&
        ref.type in ['audio', 'video'];
    }

    function isValidChoicePoint(cp) {
      return cp is map &&
        cp.keys().hasAll(['id', 'promptEn', 'promptHi', 'options']) &&
        cp.keys().hasOnly(['id', 'triggerAtSec', 'triggerAtEnd', 'promptEn', 'promptHi', 'options']) &&
        cp.id is string && isValidId(cp.id) &&
        (!('triggerAtSec' in cp) || (cp.triggerAtSec is number && cp.triggerAtSec >= 1 && cp.triggerAtSec <= 86400)) &&
        (!('triggerAtEnd' in cp) || cp.triggerAtEnd is bool) &&
        cp.promptEn is string && cp.promptEn.size() >= 1 && cp.promptEn.size() <= 300 &&
        cp.promptHi is string && cp.promptHi.size() >= 1 && cp.promptHi.size() <= 300 &&
        cp.options is list && cp.options.size() >= 2 && cp.options.size() <= 3 &&
        cp.options[0] is map;
    }

    function isValidEpisode(data, episodeId) {
      return data.keys().hasAll([
          'id', 'storyId', 'creatorOwnerUid', 'episodeNumber', 'title', 'titleHi',
          'durationSec', 'priceCoins', 'mediaRef', 'publishedAt', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storyId', 'creatorOwnerUid', 'episodeNumber', 'title', 'titleHi',
          'description', 'descriptionHi', 'durationSec', 'priceCoins', 'accessTier',
          'mediaRef', 'audioRef', 'videoMediaRef', 'choicePoint', 'isEnding',
          'isDeleted', 'deletedAt', 'deletedByUid', 'publishedAt', 'createdAt'
        ]) &&
        data.id is string && data.id == episodeId && isValidId(data.id) &&
        data.storyId is string && isValidId(data.storyId) &&
        data.creatorOwnerUid is string && isValidId(data.creatorOwnerUid) &&
        data.episodeNumber is number && data.episodeNumber >= 1 && data.episodeNumber <= 1000 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.titleHi is string && data.titleHi.size() >= 1 && data.titleHi.size() <= 160 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 600)) &&
        (!('descriptionHi' in data) || (data.descriptionHi is string && data.descriptionHi.size() <= 600)) &&
        data.durationSec is number && data.durationSec >= 1 && data.durationSec <= 86400 &&
        isValidCoinPrice(data.priceCoins) &&
        (!('accessTier' in data) || data.accessTier == null || (data.accessTier is string && data.accessTier.size() <= 32)) &&
        isValidMediaRef(data.mediaRef) &&
        (!('audioRef' in data) || isValidMediaRef(data.audioRef)) &&
        (!('videoMediaRef' in data) || isValidMediaRef(data.videoMediaRef)) &&
        (!('choicePoint' in data) || isValidChoicePoint(data.choicePoint)) &&
        (!('isEnding' in data) || data.isEnding is bool) &&
        (!('isDeleted' in data) || data.isDeleted is bool) &&
        (!('deletedAt' in data) || data.deletedAt == null || data.deletedAt is timestamp) &&
        (!('deletedByUid' in data) || data.deletedByUid == null || (data.deletedByUid is string && isValidId(data.deletedByUid))) &&
        data.publishedAt is timestamp &&
        data.createdAt is timestamp;
    }

    function isValidCoinWallet(data, userId) {
      return data.keys().hasAll(['uid', 'balance', 'lifetimePurchased', 'lifetimeSpent', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'balance', 'lifetimePurchased', 'lifetimeSpent', 'updatedAt']) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.balance is number && data.balance >= 0 && data.balance <= 100000000 && data.balance % 1 == 0 &&
        data.lifetimePurchased is number && data.lifetimePurchased >= 0 && data.lifetimePurchased <= 100000000 && data.lifetimePurchased % 1 == 0 &&
        data.lifetimeSpent is number && data.lifetimeSpent >= 0 && data.lifetimeSpent <= 100000000 && data.lifetimeSpent % 1 == 0 &&
        data.updatedAt is timestamp;
    }

    function isValidCoinTransaction(data, txId) {
      return data.keys().hasAll(['id', 'uid', 'type', 'amount', 'balanceAfter', 'createdAt', 'note']) &&
        data.keys().hasOnly([
          'id', 'uid', 'type', 'amount', 'balanceAfter',
          'episodeId', 'storyId', 'creatorId', 'createdAt', 'note'
        ]) &&
        data.id is string && data.id == txId && isValidId(data.id) &&
        data.uid is string && isValidId(data.uid) &&
        data.type in ['purchase', 'spend', 'admin_adjust', 'bonus', 'refund'] &&
        data.amount is number && data.amount != 0 && data.amount >= -1000000 && data.amount <= 1000000 && data.amount % 1 == 0 &&
        data.balanceAfter is number && data.balanceAfter >= 0 && data.balanceAfter <= 100000000 && data.balanceAfter % 1 == 0 &&
        (!('episodeId' in data) || data.episodeId == null || (data.episodeId is string && data.episodeId.size() <= 128)) &&
        (!('storyId' in data) || data.storyId == null || (data.storyId is string && data.storyId.size() <= 128)) &&
        (!('creatorId' in data) || data.creatorId == null || (data.creatorId is string && data.creatorId.size() <= 128)) &&
        data.note is string && data.note.size() >= 1 && data.note.size() <= 300 &&
        data.createdAt is timestamp;
    }

    function isValidCoinPackage(data, packageId) {
      return data.keys().hasAll(['id', 'name', 'coins', 'bonusCoins', 'priceInr', 'active', 'sortOrder']) &&
        data.keys().hasOnly([
          'id', 'name', 'nameHi', 'coins', 'bonusCoins', 'priceInr',
          'active', 'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == packageId && isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        (!('nameHi' in data) || (data.nameHi is string && data.nameHi.size() <= 80)) &&
        data.coins is number && data.coins >= 1 && data.coins <= 1000000 && data.coins % 1 == 0 &&
        data.bonusCoins is number && data.bonusCoins >= 0 && data.bonusCoins <= 1000000 && data.bonusCoins % 1 == 0 &&
        data.priceInr is number && data.priceInr >= 0 && data.priceInr <= 1000000 &&
        data.active is bool &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidEconomySettings(data) {
      return data.keys().hasAll(['id', 'dailyFreeEnabled', 'dailyFreeLimit', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'dailyFreeEnabled', 'dailyFreeLimit', 'updatedAt', 'updatedByUid']) &&
        data.id == 'economy' &&
        data.dailyFreeEnabled is bool &&
        data.dailyFreeLimit is number && data.dailyFreeLimit >= 0 && data.dailyFreeLimit <= 20 && data.dailyFreeLimit % 1 == 0 &&
        (!('updatedByUid' in data) || (data.updatedByUid is string && isValidId(data.updatedByUid))) &&
        data.updatedAt is timestamp;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll([
          'id', 'branding', 'footer', 'heroBanners', 'homepageSections',
          'languages', 'defaultLanguage', 'legalPages', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'branding', 'footer', 'heroBanners', 'homepageSections',
          'languages', 'defaultLanguage', 'legalPages', 'updatedAt', 'updatedByUid'
        ]) &&
        data.id == 'main' &&
        data.branding is map &&
        data.footer is map &&
        data.heroBanners is list && data.heroBanners.size() <= 10 &&
        (data.heroBanners.size() == 0 || data.heroBanners[0] is map) &&
        data.homepageSections is list && data.homepageSections.size() <= 16 &&
        (data.homepageSections.size() == 0 || data.homepageSections[0] is map) &&
        data.languages is list && data.languages.size() >= 1 && data.languages.size() <= 10 &&
        data.languages[0] is map &&
        data.defaultLanguage is string && data.defaultLanguage.size() >= 2 && data.defaultLanguage.size() <= 10 &&
        data.legalPages is map &&
        (!('updatedByUid' in data) || (data.updatedByUid is string && isValidId(data.updatedByUid))) &&
        data.updatedAt is timestamp;
    }

    function isValidListeningHistory(data, historyId) {
      return data.keys().hasAll([
          'id', 'userId', 'storyId', 'episodeId', 'episodeNumber',
          'positionSec', 'durationSec', 'completed', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'storyId', 'storyOwnerUid', 'episodeId', 'episodeNumber',
          'positionSec', 'durationSec', 'completed', 'updatedAt'
        ]) &&
        data.id is string && data.id == historyId && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid && isValidId(data.userId) &&
        data.storyId is string && isValidId(data.storyId) &&
        (!('storyOwnerUid' in data) || (data.storyOwnerUid is string && isValidId(data.storyOwnerUid))) &&
        data.episodeId is string && isValidId(data.episodeId) &&
        data.episodeNumber is number && data.episodeNumber >= 1 && data.episodeNumber <= 1000 &&
        data.positionSec is number && data.positionSec >= 0 && data.positionSec <= 86400 &&
        data.durationSec is number && data.durationSec >= 1 && data.durationSec <= 86400 &&
        data.completed is bool &&
        data.updatedAt is timestamp;
    }

    function isValidBookmark(data, bookmarkId) {
      return data.keys().hasAll(['id', 'userId', 'targetType', 'targetId', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'targetType', 'targetId', 'createdAt']) &&
        data.id is string && data.id == bookmarkId && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid && isValidId(data.userId) &&
        data.targetType in ['story_bookmark', 'story_favorite', 'creator_follow'] &&
        data.targetId is string && isValidId(data.targetId) &&
        data.createdAt is timestamp;
    }

    function isValidDailyUnlock(data, unlockId) {
      return data.keys().hasAll(['id', 'userId', 'storyId', 'episodeId', 'unlockDate', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'storyId', 'episodeId', 'unlockDate', 'createdAt']) &&
        data.id is string && data.id == unlockId && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid && isValidId(data.userId) &&
        data.storyId is string && isValidId(data.storyId) &&
        data.episodeId is string && isValidId(data.episodeId) &&
        data.unlockDate is string && data.unlockDate.size() == 10 && data.unlockDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.createdAt is timestamp;
    }

    function isValidInteractiveChoice(data, choiceId) {
      return data.keys().hasAll(['id', 'storyId', 'episodeId', 'promptEn', 'promptHi', 'options', 'createdAt']) &&
        data.keys().hasOnly(['id', 'storyId', 'episodeId', 'promptEn', 'promptHi', 'options', 'createdAt']) &&
        data.id is string && data.id == choiceId && isValidId(data.id) &&
        data.storyId is string && isValidId(data.storyId) &&
        data.episodeId is string && isValidId(data.episodeId) &&
        data.promptEn is string && data.promptEn.size() >= 1 && data.promptEn.size() <= 300 &&
        data.promptHi is string && data.promptHi.size() >= 1 && data.promptHi.size() <= 300 &&
        data.options is list && data.options.size() >= 1 && data.options.size() <= 4 &&
        data.options[0] is map &&
        data.createdAt is timestamp;
    }

    function isValidUserChoice(data, userChoiceId) {
      return data.keys().hasAll([
          'id', 'userId', 'storyId', 'episodeId', 'choicePointId',
          'optionId', 'optionLabelEn', 'optionLabelHi', 'nextEpisodeId', 'chosenAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'storyId', 'episodeId', 'choicePointId',
          'optionId', 'optionLabelEn', 'optionLabelHi', 'nextEpisodeId', 'chosenAt'
        ]) &&
        data.id is string && data.id == userChoiceId && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid && isValidId(data.userId) &&
        data.storyId is string && isValidId(data.storyId) &&
        data.episodeId is string && isValidId(data.episodeId) &&
        data.choicePointId is string && isValidId(data.choicePointId) &&
        data.optionId is string && isValidId(data.optionId) &&
        data.optionLabelEn is string && data.optionLabelEn.size() >= 1 && data.optionLabelEn.size() <= 160 &&
        data.optionLabelHi is string && data.optionLabelHi.size() >= 1 && data.optionLabelHi.size() <= 160 &&
        data.nextEpisodeId is string && isValidId(data.nextEpisodeId) &&
        data.chosenAt is timestamp;
    }

    function isValidCreatorRequest(data, requestId) {
      return data.keys().hasAll([
          'id', 'userId', 'userEmail', 'userName', 'studioName', 'handle',
          'language', 'pitch', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'userEmail', 'userName', 'studioName', 'handle',
          'language', 'pitch', 'sampleLink', 'status', 'reviewNote', 'reviewedByUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == requestId && isValidId(data.id) &&
        data.userId is string && data.userId == requestId && isValidId(data.userId) &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 200 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.studioName is string && data.studioName.size() >= 1 && data.studioName.size() <= 100 &&
        data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 60 &&
        data.language in ['en', 'hi', 'bilingual'] &&
        data.pitch is string && data.pitch.size() >= 10 && data.pitch.size() <= 600 &&
        (!('sampleLink' in data) || (data.sampleLink is string && data.sampleLink.size() <= 300)) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() <= 300)) &&
        (!('reviewedByUid' in data) || (data.reviewedByUid is string && isValidId(data.reviewedByUid))) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data, logId) {
      return data.keys().hasAll([
          'id', 'actorUid', 'actorEmail', 'action', 'targetCollection', 'targetId', 'summary', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'actorUid', 'actorEmail', 'action', 'targetCollection', 'targetId', 'summary', 'createdAt'
        ]) &&
        data.id is string && data.id == logId && isValidId(data.id) &&
        data.actorUid is string && data.actorUid == request.auth.uid && isValidId(data.actorUid) &&
        data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 200 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 64 &&
        data.targetCollection is string && data.targetCollection.size() >= 1 && data.targetCollection.size() <= 64 &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 400 &&
        data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // 1. Users (PII isolated strictly to owner or admin; role, isDisabled, warningCount, banned, activeDevice are NEVER user-editable)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isVerified() &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().role == 'user' &&
        !('admin' in incoming()) &&
        (!('isDisabled' in incoming()) || incoming().isDisabled == false) &&
        !('warningCount' in incoming()) &&
        !('banned' in incoming()) &&
        !('bannedAt' in incoming()) &&
        !('banReason' in incoming()) &&
        !('activeDevice' in incoming()) &&
        !('lastSeen' in incoming()) &&
        !('subscriptionTier' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isVerified() &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isOwner(userId) &&
            (!('banned' in existing()) || existing().banned == false) &&
            incoming().role == existing().role &&
            (!('admin' in incoming()) || ('admin' in existing() && incoming().admin == existing().admin)) &&
            incoming().email == existing().email &&
            (!('isDisabled' in incoming()) || ('isDisabled' in existing() && incoming().isDisabled == existing().isDisabled)) &&
            (!('warningCount' in incoming()) || ('warningCount' in existing() && incoming().warningCount == existing().warningCount)) &&
            (!('banned' in incoming()) || ('banned' in existing() && incoming().banned == existing().banned)) &&
            (!('activeDevice' in incoming()) || ('activeDevice' in existing() && incoming().activeDevice == existing().activeDevice)) &&
            (!('subscriptionTier' in incoming()) || ('subscriptionTier' in existing() && incoming().subscriptionTier == existing().subscriptionTier)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'bio', 'preferredLanguage', 'preferredFormat',
              'avatarInitials', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isVerified() && (isOwner(userId) || isAdmin());
    }

    // 2. Admins registry (strictly admin-managed)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }

    // 3. Categories (public non-PII catalog, Admin CRUD)
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isAdmin();
      allow create: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming(), categoryId);
      allow update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming(), categoryId) &&
        incoming().id == existing().id;
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // 4. Creators (public storyteller profiles, Admin or creator-owner editable)
    match /creators/{creatorId} {
      allow get: if isValidId(creatorId) && (existing().followersCount >= 0 || isAdmin());
      allow list: if existing().followersCount >= 0 || isAdmin();
      allow create: if isValidId(creatorId) && isAdmin() && isValidCreator(incoming(), creatorId);
      allow update: if isValidId(creatorId) && isValidCreator(incoming(), creatorId) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid && (
          isAdmin() || (
            isCreatorRole() &&
            existing().ownerUid == request.auth.uid &&
            incoming().verified == existing().verified &&
            incoming().followersCount == existing().followersCount &&
            incoming().storiesCount == existing().storiesCount &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'bioEn', 'bioHi', 'language', 'accentPalette'])
          )
        );
      allow delete: if isValidId(creatorId) && isAdmin();
    }

    // 5. Stories (public when published; creators edit/delete ONLY their own; priceOverrideCoins strictly Admin-only)
    match /stories/{storyId} {
      allow get: if isValidId(storyId) && (
        (existing().visibility == 'published' && (!('isDeleted' in existing()) || existing().isDeleted == false)) ||
        isAdmin() ||
        (isSignedIn() && existing().creatorOwnerUid == request.auth.uid && (!('isDeleted' in existing()) || existing().isDeleted == false))
      );
      allow list: if existing().visibility == 'published' ||
        isAdmin() ||
        (isSignedIn() && existing().creatorOwnerUid == request.auth.uid);
      allow create: if isValidId(storyId) &&
        isValidStory(incoming(), storyId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isCreatorRole() &&
            incoming().creatorOwnerUid == request.auth.uid &&
            incoming().isFeatured == false &&
            incoming().isEditorsPick == false &&
            incoming().isTrending == false &&
            (!('priceOverrideCoins' in incoming()) || incoming().priceOverrideCoins == null) &&
            (!('isDeleted' in incoming()) || incoming().isDeleted == false) &&
            incoming().visibility in ['draft', 'published'] &&
            exists(/databases/$(database)/documents/creators/$(incoming().creatorId)) &&
            get(/databases/$(database)/documents/creators/$(incoming().creatorId)).data.ownerUid == request.auth.uid
          )
        );
      allow update: if isValidId(storyId) &&
        isValidStory(incoming(), storyId) &&
        incoming().id == existing().id &&
        incoming().creatorOwnerUid == existing().creatorOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isCreatorRole() &&
            existing().creatorOwnerUid == request.auth.uid &&
            incoming().isFeatured == existing().isFeatured &&
            incoming().isEditorsPick == existing().isEditorsPick &&
            incoming().isTrending == existing().isTrending &&
            incoming().visibility in ['draft', 'published'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'titleHi', 'synopsis', 'synopsisHi', 'genreId', 'language',
              'coverUrl', 'backdropUrl', 'coverTheme', 'visibility', 'format',
              'isInteractive', 'episodeCount', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(storyId) && (
        isAdmin() || (isCreatorRole() && existing().creatorOwnerUid == request.auth.uid)
      );
    }

    // 6. Episodes (creator sets priceCoins ONCE on create; immutable for creator on update; Admin can edit anytime)
    match /episodes/{episodeId} {
      allow get: if isValidId(episodeId) && (
        (existing().episodeNumber >= 1 && (!('isDeleted' in existing()) || existing().isDeleted == false)) ||
        isAdmin()
      );
      allow list: if existing().episodeNumber >= 1 || isAdmin();
      allow create: if isValidId(episodeId) &&
        isValidEpisode(incoming(), episodeId) &&
        !('accessTier' in incoming()) &&
        incoming().createdAt == request.time && (
          isAdmin() || (
            isCreatorRole() &&
            incoming().creatorOwnerUid == request.auth.uid &&
            (!('isDeleted' in incoming()) || incoming().isDeleted == false) &&
            exists(/databases/$(database)/documents/stories/$(incoming().storyId)) &&
            get(/databases/$(database)/documents/stories/$(incoming().storyId)).data.creatorOwnerUid == request.auth.uid
          )
        );
      allow update: if isValidId(episodeId) &&
        isValidEpisode(incoming(), episodeId) &&
        incoming().id == existing().id &&
        incoming().storyId == existing().storyId &&
        incoming().creatorOwnerUid == existing().creatorOwnerUid &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() || (
            isCreatorRole() &&
            existing().creatorOwnerUid == request.auth.uid &&
            incoming().priceCoins == existing().priceCoins &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'episodeNumber', 'title', 'titleHi', 'description', 'descriptionHi', 'durationSec',
              'mediaRef', 'audioRef', 'videoMediaRef', 'choicePoint', 'isEnding'
            ])
          )
        );
      allow delete: if isValidId(episodeId) && (
        isAdmin() || (isCreatorRole() && existing().creatorOwnerUid == request.auth.uid)
      );
    }

    // 7. Listening History (strictly user-owned writes; readable by owner, story creator for analytics, or admin)
    match /listeningHistory/{historyId} {
      allow get: if isValidId(historyId) && isSignedIn() && (
        existing().userId == request.auth.uid ||
        ('storyOwnerUid' in existing() && existing().storyOwnerUid == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        ('storyOwnerUid' in existing() && existing().storyOwnerUid == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isValidId(historyId) &&
        isVerified() &&
        isValidListeningHistory(incoming(), historyId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(historyId) &&
        isVerified() &&
        isValidListeningHistory(incoming(), historyId) &&
        existing().userId == request.auth.uid &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().storyId == existing().storyId &&
        incoming().episodeId == existing().episodeId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'positionSec', 'durationSec', 'completed', 'episodeNumber', 'storyOwnerUid', 'updatedAt'
        ]);
      allow delete: if isValidId(historyId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
    }

    // 8. Bookmarks, Favorites, and Follows (strictly user-owned)
    match /bookmarks/{bookmarkId} {
      allow get: if isValidId(bookmarkId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isValidId(bookmarkId) &&
        isVerified() &&
        isValidBookmark(incoming(), bookmarkId) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(bookmarkId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
    }

    // 9. Daily Unlocks (strictly user-owned, immutable unlock claim)
    match /dailyUnlocks/{unlockId} {
      allow get: if isValidId(unlockId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isValidId(unlockId) &&
        isVerified() &&
        isValidDailyUnlock(incoming(), unlockId) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(unlockId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
    }

    // 10. Coin Wallets (read-only for regular users; writable only by server Admin SDK or verified Admins)
    match /wallets/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isAdmin() &&
        isValidCoinWallet(incoming(), userId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isAdmin() &&
        isValidCoinWallet(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 11. Coin Transactions (IMMUTABLE append-only ledger; regular users read-only; verified Admins may append admin_adjust/bonus/refund)
    match /coinTransactions/{txId} {
      allow get: if isValidId(txId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow create: if isValidId(txId) &&
        isAdmin() &&
        isValidCoinTransaction(incoming(), txId) &&
        incoming().type in ['admin_adjust', 'bonus', 'refund'] &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 12. Permanent Episode Unlocks (STRICTLY server-written via /api/coins/unlock; read-only for owner or Admin)
    match /episodeUnlocks/{unlockId} {
      allow get: if isValidId(unlockId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // 13. Coin Packages (public read of active packages; strictly Admin CRUD)
    match /coinPackages/{packageId} {
      allow get: if isValidId(packageId) && (existing().active == true || isAdmin());
      allow list: if existing().active == true || isAdmin();
      allow create: if isValidId(packageId) && isAdmin() && isValidCoinPackage(incoming(), packageId);
      allow update: if isValidId(packageId) && isAdmin() && isValidCoinPackage(incoming(), packageId) &&
        incoming().id == existing().id;
      allow delete: if isValidId(packageId) && isAdmin();
    }

    // 14. Platform Settings (public read for economy config; strictly Admin-managed)
    match /platformSettings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'economy';
      allow list: if isAdmin();
      allow create, update: if isValidId(settingId) &&
        settingId == 'economy' &&
        isAdmin() &&
        isValidEconomySettings(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 15. Interactive Choices (branch definitions, public read, admin managed)
    match /interactiveChoices/{choiceId} {
      allow get: if isValidId(choiceId) && (existing().options.size() >= 1 || isAdmin());
      allow list: if existing().options.size() >= 1 || isAdmin();
      allow create: if isValidId(choiceId) && isAdmin() &&
        isValidInteractiveChoice(incoming(), choiceId) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(choiceId) && isAdmin() &&
        isValidInteractiveChoice(incoming(), choiceId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(choiceId) && isAdmin();
    }

    // 16. User Choices (interactive branch selections, strictly user-owned)
    match /userChoices/{userChoiceId} {
      allow get: if isValidId(userChoiceId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isValidId(userChoiceId) &&
        isVerified() &&
        isValidUserChoice(incoming(), userChoiceId) &&
        incoming().chosenAt == request.time;
      allow update: if isValidId(userChoiceId) &&
        isVerified() &&
        isValidUserChoice(incoming(), userChoiceId) &&
        existing().userId == request.auth.uid &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().storyId == existing().storyId &&
        incoming().episodeId == existing().episodeId &&
        incoming().chosenAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'choicePointId', 'optionId', 'optionLabelEn', 'optionLabelHi', 'nextEpisodeId', 'chosenAt'
        ]);
      allow delete: if isValidId(userChoiceId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
    }

    // 17. Creator Requests (users apply as pending; only admins approve or reject)
    match /creatorRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (isOwner(requestId) || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isValidId(requestId) &&
        isVerified() &&
        isOwner(requestId) &&
        isValidCreatorRequest(incoming(), requestId) &&
        incoming().status == 'pending' &&
        !('reviewedByUid' in incoming()) &&
        !('reviewNote' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(requestId) &&
        isVerified() &&
        isValidCreatorRequest(incoming(), requestId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isOwner(requestId) &&
            existing().status == 'rejected' &&
            incoming().status == 'pending' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'studioName', 'handle', 'language', 'pitch', 'sampleLink', 'status', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(requestId) && isAdmin();
    }

    // 18. Audit Logs (strictly admin-only read & append-only create; immutable)
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) &&
        isAdmin() &&
        isValidAuditLog(incoming(), logId) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    // 19. Single-Device Sessions Log (STRICTLY server-written via Firebase Admin SDK; read-only for owner or Admin)
    match /sessions/{sessionId} {
      allow get: if isValidId(sessionId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // 20. Site Settings (public read for canonical 'main' doc so site renders live branding/banners/sections/legal; strictly Admin-only writes)
    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'main';
      allow list: if isAdmin();
      allow create, update: if isValidId(settingId) &&
        settingId == 'main' &&
        isAdmin() &&
        isValidSiteSettings(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }
  }
}
