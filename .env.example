# =============================================================================
# Dhruv Tales — Environment Variables (Portable Across Any Hosting Server)
# =============================================================================
# SECURITY WARNING:
# - ONLY VITE_API_BASE_URL may have a VITE_ prefix (it is a public URL).
# - NEVER prefix secrets below with VITE_.
# - NEVER commit real values or service-account JSON key files to Git.
# - Configure real values in your hosting provider's Environment Variables panel
#   (Cloudflare Pages, Render, Railway, Cloud Run, Fly.io, VPS, Docker, or Vercel).
# =============================================================================

# --- Optional Frontend Build Variable (Static Hosting / Split Frontend) ------
# Leave EMPTY when frontend and /api run on the same server (Render, Railway,
# Cloud Run, Fly.io, VPS, Docker, Vercel, or local `npm run dev`).
# Set ONLY if your frontend is on static hosting (Cloudflare Pages, Netlify,
# Firebase Hosting) or a mobile app pointing to a separate backend API server.
# Example: https://api.yourdomain.com
VITE_API_BASE_URL=

# --- Portable Node.js Server & Cross-Origin Security -------------------------
# Comma-separated list of allowed frontend origins when calling /api cross-origin.
# Wildcard (*) is ignored for security.
# Example: https://your-site.pages.dev,https://dhruvtales.com,capacitor://localhost
ALLOWED_ORIGINS=

# Port for the standalone Node.js server (`npm start` / Docker). Defaults to 3000.
PORT=3000

# Set to "true" to run ONLY the /api endpoints without serving dist/ static files.
API_ONLY=false

# --- Server-Side Secrets (Backend API Server ONLY) ---------------------------

# 1. Google Drive Service Account JSON (for private Drive path resolution, folder browsing, & protected streaming)
# Provide either a single-line JSON string OR a base64-encoded JSON string of the
# Google Cloud service account key with Google Drive API enabled.
# Works identically on Node, Vercel, Cloud Run, and Cloudflare Workers (worker.ts).
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Optional: Root Google Drive folder ID for path lookups (e.g. Trinetra/EP_1.wav).
# If omitted, paths automatically resolve starting from folders shared with your Service Account.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# 2. Firebase Admin SDK Credentials (for /api/session/*, /api/coins/*, /api/admin/*, /api/media/*)
# Option A (Recommended): Single-line JSON string OR base64-encoded JSON string
# of the Firebase Admin service account key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B (Alternative to FIREBASE_SERVICE_ACCOUNT_JSON): Individual fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: Named Firestore Database ID (defaults to firestoreDatabaseId from
# firebase-applet-config.json if omitted, e.g. ai-studio-dhruvtales-...)
FIREBASE_DATABASE_ID=

# 3. HMAC Signing Secret for short-lived (5-minute) /api/media/stream tokens
# Generate a random 32+ byte secret (e.g. `openssl rand -hex 32`).
MEDIA_SIGNING_SECRET=
